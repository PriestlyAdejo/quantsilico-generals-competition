{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".venv/Scripts/python.exe .qoder/hooks/guard_destructive.py",
        "fail_closed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": ".venv/Scripts/python.exe .qoder/hooks/post_edit_ruff.py",
        "matcher": "Write|Edit",
        "fail_closed": false
      }
    ],
    "stop": [
      {
        "command": ".venv/Scripts/python.exe .qoder/hooks/marathon_stop_gate.py",
        "fail_closed": false
      }
    ]
  }
}
